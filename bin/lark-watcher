#!/bin/bash
# lark-watcher: Background watcher for Feishu→Claude Code bridge
# Polls .lark-events/ for new files and processes them through claude --print.
# Called by lark-claude-bridge, not meant for direct use.

set -euo pipefail

export LARK_CLI_NO_PROXY=1

BRIDGE_DIR="${1:?missing BRIDGE_DIR}"
EVENTS_DIR="${2:?missing EVENTS_DIR}"
PROCESSED_DIR="${3:?missing PROCESSED_DIR}"
EVENT_LOG="${4:?missing EVENT_LOG}"
CLAUDE_LOG="${5:?missing CLAUDE_LOG}"
REPLY_LOG="${6:?missing REPLY_LOG}"

cd "$BRIDGE_DIR"
mkdir -p "$PROCESSED_DIR"

reply_feishu() {
  lark-cli im +messages-send --chat-id "$1" --as bot --text "$2" \
    >/dev/null 2>> "$REPLY_LOG" || true
}

process_one() {
  local file="$1"
  local base msg_type chat_id content sender_id chat_type
  base=$(basename "$file")
  [ -f "$PROCESSED_DIR/$base" ] && return 2

  msg_type=$(python3 -c "import json; d=json.load(open('$file')); print(d.get('message_type',''))" 2>/dev/null || true)
  chat_id=$(python3 -c "import json; d=json.load(open('$file')); print(d.get('chat_id',''))" 2>/dev/null || true)
  content=$(python3 -c "import json; d=json.load(open('$file')); print(d.get('content',''))" 2>/dev/null || true)
  sender_id=$(python3 -c "import json; d=json.load(open('$file')); print(d.get('sender_id',''))" 2>/dev/null || true)
  chat_type=$(python3 -c "import json; d=json.load(open('$file')); print(d.get('chat_type',''))" 2>/dev/null || true)

  [ "$msg_type" != "text" ] && return 1
  [ -z "$chat_id" ] && return 1
  [ -z "$content" ] && return 1

  # Strip bot mention in group chats
  if [ "$chat_type" = "group" ]; then
    content="${content#@kyb-infra}"
    content="${content# }"
  fi
  [ -z "$content" ] && return 1

  echo "$(date '+%H:%M:%S') >>> [$chat_id] $sender_id: $content" >> "$EVENT_LOG"
  touch "$PROCESSED_DIR/$base"

  # Thinking indicator (async, best-effort)
  reply_feishu "$chat_id" "🤔 正在调用 Claude Code..." &

  # Claude --print with 10-minute timeout
  local response
  response=$(timeout 600 bash -c 'echo "$1" | claude --print --continue 2>> "$2"' _ "$content" "$CLAUDE_LOG" 2>/dev/null || echo "（Claude Code 超时或出错）")
  [ -z "$response" ] && response="（Claude 没有产生输出）"

  echo "$(date '+%H:%M:%S') <<< $(echo "$response" | head -c 300)" >> "$EVENT_LOG"
  reply_feishu "$chat_id" "$response"
  echo "$(date '+%H:%M:%S') DONE" >> "$EVENT_LOG"
}

# Process existing events (glob may be literal if no match, handle that)
shopt -s nullglob
for f in "$EVENTS_DIR"/[0-9]*.json; do
  [ -f "$f" ] && process_one "$f" || true
done

# Poll loop
while true; do
  for f in "$EVENTS_DIR"/[0-9]*.json; do
    [ -f "$f" ] || continue
    fbase=$(basename "$f")
    [ ! -f "$PROCESSED_DIR/$fbase" ] && process_one "$f" || true
  done
  sleep 2
done
