#!/bin/bash
# 发送通知到飞书 + 钉钉群
# Usage: notify-im "消息内容"

MSG=$1
if [ -z "$MSG" ]; then
  echo "Usage: notify-im <message>"
  exit 1
fi

FEISHU_URL="${FEISHU_BOT_WEBHOOK:?notify-im: FEISHU_BOT_WEBHOOK not set}"
DINGTALK_URL="${DINGTALK_BOT_WEBHOOK:?notify-im: DINGTALK_BOT_WEBHOOK not set}"

# 飞书 (text)
curl -s -X POST "$FEISHU_URL" \
  -H "Content-Type: application/json" \
  -d "$(python3 -c "import json,sys; print(json.dumps({'msg_type':'text','content':{'text':sys.argv[1]}}))" "$MSG")" \
  -o /dev/null &

# 钉钉 (text)
curl -s -X POST "$DINGTALK_URL" \
  -H "Content-Type: application/json" \
  -d "$(python3 -c "import json,sys; print(json.dumps({'msgtype':'text','text':{'content':sys.argv[1]}}))" "$MSG")" \
  -o /dev/null &

wait
echo "notified"
