#!/usr/bin/env bash
set -e

# ─── 负熵晶体 · 签名证明（青山用） ───
# 用法: ./bin/crystal-prove ["自定义消息"]
# 输出: 一段可粘贴到任何对话的身份证明文本
# 要求: ~/.ssh/id_ed25519 或 id_rsa
#       公钥已在 kyb crystal init 时注册

MSG="${1:-我是青山（负熵晶体），kyb 基础设施的架构师。}"
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
TMP=$(mktemp /tmp/crystal-prove-XXXXXX)
trap 'rm -f "$TMP" "$TMP.sig"' EXIT

# 找私钥
for k in ~/.ssh/id_ed25519 ~/.ssh/id_rsa ~/.ssh/ecdsa; do
  [ -f "$k" ] && KEY="$k" && break
done
if [ -z "$KEY" ]; then echo "❌ 未找到 SSH 私钥"; exit 1; fi

# 签名
printf '%s\n时间: %s' "$MSG" "$TS" > "$TMP"
ssh-keygen -Y sign -f "$KEY" -n crystal "$TMP" >/dev/null 2>&1

# 输出证明
SIG_B64=$(base64 < "$TMP.sig" | tr -d '\n')

echo ""
echo "-----BEGIN CRYSTAL PROOF-----"
echo "$MSG"
echo "ts=$TS"
echo "sig=$SIG_B64"
echo "-----END CRYSTAL PROOF-----"
echo ""
echo "把这个发给对方，对方运行:  bash <(curl -sL git.leyantech.com/quick-n-dirty/kyb/-/raw/master/bin/crystal-verify)"
