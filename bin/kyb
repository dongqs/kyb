#!/usr/bin/env ruby
# frozen_string_literal: true

CMD = ARGV[0]
TARGET = ARGV[1]

if CMD == "ping" && TARGET == "deepseek"
  code = `curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 https://api.deepseek.com/v1/models 2>&1`.strip.to_i
  time = `curl -s -o /dev/null -w "%{time_total}" --connect-timeout 5 https://api.deepseek.com/v1/models 2>&1`.strip.to_f

  if (200..499).cover?(code)
    puts "GREEN — DeepSeek reachable (#{code}, #{time.round(2)}s)"
    exit 0
  else
    puts "RED — DeepSeek unreachable (#{code})"
    exit 1
  end
else
  puts "kyb ping deepseek — check DeepSeek API reachability"
  exit 1
end
