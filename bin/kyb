#!/usr/bin/env ruby
# frozen_string_literal: true

require 'yaml'
require 'fileutils'

# kyb — kubernate your branches — dev sandbox CLI
module Ky
  CONFIG_FILE = File.expand_path('~/.config/ky/config.yml')
  BASE_IMAGE = 'dev-sandbox-base'
  WORKTREE_BASE = File.expand_path('~/.ky/worktrees')

  module_function

  def die(msg)
    warn "ERROR: #{msg}"
    exit 1
  end
end

# ---------- Config ----------

module Ky::Config
  module_function

  def load
    Ky.die("#{Ky::CONFIG_FILE} not found") unless File.exist?(Ky::CONFIG_FILE)
    @config ||= YAML.safe_load_file(Ky::CONFIG_FILE, permitted_classes: [Symbol])
  end

  def base_image_path
    File.expand_path(load.dig('base', 'image'))
  end

  def project(name)
    p = load.dig('projects', name)
    Ky.die("'#{name}' not found in #{Ky::CONFIG_FILE}") unless p
    {
      name: name,
      path: File.expand_path(p['path']),
      base_branch: p['base_branch'],
      dockerfile: p['dockerfile'],
      ports: Array(p['ports']).map(&:to_s).reject(&:empty?).join(','),
      symlinks: Array(p['symlinks']).map(&:to_s).reject(&:empty?).join(','),
      env_template: p['env_template']
    }
  end

  def project_names
    (load['projects'] || {}).keys.sort
  end
end

# ---------- Docker ----------

module Ky::Docker
  module_function

  def build(tag, path)
    puts "==> Building base image: #{tag}"
    system('docker', 'build', '-t', tag, path.to_s) || Ky.die('docker build failed')
  end

  def project_image(name, dockerfile, context)
    image = "dev-#{name}"
    puts "==> #{name}: building project image (#{dockerfile})"
    system('docker', 'build', '-t', image, '-f', dockerfile.to_s, context.to_s) || Ky.die('docker build failed')
    image
  end

  def container_name(name, port = nil)
    port ? "dev-#{name}-#{port}" : "dev-#{name}"
  end

  def running?(container)
    `docker ps --format '{{.Names}}'`.lines.map(&:strip).include?(container)
  end

  def exists?(container)
    `docker ps -a --format '{{.Names}}'`.lines.map(&:strip).include?(container)
  end

  def ps_list
    out = `docker ps -a --format '{{.Names}}\t{{.Status}}\t{{.Ports}}' --filter 'name=dev-' 2>/dev/null`
    return [] if out.strip.empty?
    out.lines.map { |l| l.strip.split("\t", 3) }
  end

  def remove_container(container)
    if exists?(container)
      puts "==> #{container}: removing container"
      system('docker', 'rm', '-f', container)
    else
      puts "==> #{container}: container not found, skip"
    end
  end

  def volume_rm(volume)
    return unless system('docker', 'volume', 'ls', '-q', out: File::NULL) &&
                  `docker volume ls -q`.lines.map(&:strip).include?(volume)
    puts "==> #{volume}: removing volume"
    system('docker', 'volume', 'rm', volume)
  end

  def containers_for_project(name)
    out = `docker ps -a --format '{{.Names}}' --filter 'name=dev-#{name}' 2>/dev/null`
    out.lines.map(&:strip).reject(&:empty?)
  end

  def run(container:, image:, hostname:, wt_path:, project_name:, project_path:, ports:, symlinks:)
    puts "==> #{container}: starting (#{wt_path} -> /home/dev/projects/#{project_name})"

    args = %w[docker run -d]
    args += ['--name', container]
    args += ['--hostname', hostname]
    args += ['-e', "HOST_UID=#{Process.uid}"]
    args += ['-e', "HOST_GID=#{Process.gid}"]
    args += ['-e', "GITLAB_TOKEN=#{ENV['GITLAB_TOKEN']}"]
    args += ['-e', "CLAUDE_CODE_ATTRIBUTION_HEADER=#{ENV['CLAUDE_CODE_ATTRIBUTION_HEADER']}"]
    args += ['-e', "CLAUDE_CODE_EFFORT_LEVEL=#{ENV['CLAUDE_CODE_EFFORT_LEVEL']}"]
    args += ['-e', "KIMI_API_KEY=#{ENV['KIMI_API_KEY']}"]
    args += ['-e', "SANDBOX_PROJECT=#{project_name}"]

    # Volume mounts
    ssh_dir = File.expand_path('~/.ssh')
    args += ['-v', "#{ssh_dir}:/home/dev/.ssh:ro"] if File.directory?(ssh_dir)
    args += ['-v', "#{ENV['HOME']}/.kimi:/home/dev/.kimi"]
    args += ['-v', "#{ENV['HOME']}/.gitconfig:/home/dev/.gitconfig:ro"]
    args += ['-v', "#{ENV['HOME']}/.claude/settings.json:/home/dev/.claude-host-settings.json:ro"]
    skills = File.expand_path('~/.claude/skills')
    args += ['-v', "#{skills}:/home/dev/.claude-skills-host:ro"] if File.directory?(skills)
    agents = File.expand_path('~/.agents')
    args += ['-v', "#{agents}:/home/.agents:ro"] if File.directory?(agents)
    args += ['-v', '/var/run/docker.sock:/var/run/docker.sock']
    args += ['-v', "#{container}-claude:/home/dev/.claude"]
    args += ['-v', "#{wt_path}:/home/dev/projects/#{project_name}"]
    args += ['-v', "#{project_name}-node_modules:/home/dev/projects/#{project_name}/node_modules"]
    args += ['-v', "#{project_path}:#{project_path}"]

    # Symlinks
    symlinks.to_s.split(',').each do |link|
      next if link.empty?
      args += ['-v', "#{project_path}/#{link}:/home/dev/projects/#{project_name}/#{link}:ro"]
    end

    # Ports
    ports.to_s.split(',').each do |p|
      next if p.empty?
      args += ['-p', p]
    end

    args << image

    system(*args) || Ky.die('docker run failed')
  end

  def stop(container)
    puts "==> Stopping #{container}"
    system('docker', 'stop', container)
    puts "==> Done: #{container} stopped"
  end

  def start_existing(container)
    if running?(container)
      puts "==> #{container} is already running"
      return
    end
    puts "==> Starting #{container}"
    system('docker', 'start', container)
    puts "==> Done: #{container} started"
  end
end

# ---------- Git ----------

module Ky::Git
  module_function

  def worktree_path(name, container)
    File.join(Ky::WORKTREE_BASE, name, container)
  end

  def branch(container)
    "sandbox/#{container.sub('dev-', '')}"
  end

  def setup_worktree(repo_path, base_branch, worktree, container)
    branch_name = branch(container)

    if File.directory?(worktree)
      puts "==> worktree exists, reusing (#{worktree})"
      return
    end

    puts "==> creating worktree from origin/#{base_branch} (#{branch_name})"
    FileUtils.mkdir_p(File.dirname(worktree))
    Dir.chdir(repo_path) do
      system('git', 'fetch', 'origin', base_branch) || Ky.die('git fetch failed')
      system('git', 'worktree', 'add', worktree, "origin/#{base_branch}", '-b', branch_name) ||
        Ky.die('git worktree add failed')
    end
  end

  def remove_worktree(repo_path, worktree)
    return unless File.directory?(worktree)

    branch_name = File.basename(worktree) # container name as fallback
    puts "==> removing worktree #{worktree}"
    Dir.chdir(repo_path) do
      unless system('git', 'worktree', 'remove', worktree)
        warn '     worktree remove failed, pruning...'
        FileUtils.rm_rf(worktree)
        system('git', 'worktree', 'prune')
      end
    end
  end

  def delete_local_branch(repo_path, container)
    branch_name = branch(container)
    Dir.chdir(repo_path) do
      return unless system('git', 'branch', '--list', branch_name, out: File::NULL) &&
                    !`git branch --list #{branch_name}`.strip.empty?
      puts "==> #{branch_name}: deleting local branch"
      system('git', 'branch', '-D', branch_name)
    end
  end

  def delete_remote_branch(repo_path, container)
    branch_name = branch(container)
    Dir.chdir(repo_path) do
      return unless system('git', 'ls-remote', '--heads', 'origin', branch_name, out: File::NULL) &&
                    !`git ls-remote --heads origin #{branch_name}`.strip.empty?
      puts "==> #{branch_name}: deleting remote branch"
      system('git', 'push', 'origin', '--delete', branch_name)
    end
  end
end

# ---------- CLI ----------

module Ky::CLI
  module_function

  def build
    Ky::Config.load
    path = Ky::Config.base_image_path
    Ky::Docker.build(Ky::BASE_IMAGE, path)
    puts "==> (◕‿‿◕) Build complete: #{Ky::BASE_IMAGE}"
  end

  def create(name, host_port = nil)
    Ky::Config.load
    proj = Ky::Config.project(name)
    path = proj[:path]
    base = Ky::Config.base_image_path

    # Build base image
    Ky::Docker.build(Ky::BASE_IMAGE, base)

    # Determine container and ports
    container = Ky::Docker.container_name(name, host_port)
    ports = host_port ? "#{host_port}:3000" : proj[:ports]
    image = Ky::BASE_IMAGE

    # Setup worktree
    wt_path = Ky::Git.worktree_path(name, container)
    Ky::Git.setup_worktree(path, proj[:base_branch], wt_path, container)

    # Setup .env from template
    if proj[:env_template] && !proj[:env_template].empty?
      src = File.join(path, proj[:env_template])
      dst = File.join(wt_path, '.env')
      puts "     cp #{src} -> .env"
      FileUtils.cp(src, dst)
    end

    # Build project-specific image
    if proj[:dockerfile]
      df_path = File.join(path, proj[:dockerfile])
      image = Ky::Docker.project_image(name, df_path, path)
    end

    # Remove existing container
    Ky::Docker.remove_container(container)

    # Ensure host dirs exist
    FileUtils.mkdir_p(File.expand_path('~/.kimi'))

    # Start container
    Ky::Docker.run(
      container: container,
      image: image,
      hostname: container,
      wt_path: wt_path,
      project_name: name,
      project_path: path,
      ports: ports,
      symlinks: proj[:symlinks]
    )

    puts
    puts "==> (◕‿‿◕) Sandbox ready! Container: #{container}  Image: #{image}  Ports: #{ports || 'none'}"
    puts "    kyb enter #{name}#{host_port ? " #{host_port}" : ''}"
  end

  def ps
    list = Ky::Docker.ps_list
    if list.empty?
      puts "(◕‿‿◕) No sandbox containers — create one with: kyb create <name>"
      return
    end
    printf "%-30s  %-24s  %s\n", 'CONTAINER', 'STATUS', 'PORTS'
    list.each { |name, status, ports| printf "%-30s  %-24s  %s\n", name, status, ports }
  end
  singleton_class.alias_method :ls, :ps

  def enter(name, port = nil)
    container = Ky::Docker.container_name(name, port)
    Ky.die("container '#{container}' is not running\n  Run: kyb create #{name}#{" #{port}" if port}") unless Ky::Docker.running?(container)

    cmd = "cd ~/projects/#{name} && mise trust && claude"
    dexec = ['docker', 'exec', '-it', '-u', 'dev', '-w', '/home/dev']
    dexec += ['-e', "KIMI_API_KEY=#{ENV['KIMI_API_KEY']}"] if ENV['KIMI_API_KEY']

    if system('docker', 'exec', '-u', 'dev', container, 'tmux', 'has-session', '-t', 'dev',
              %i[out err] => File::NULL)
      exec(*dexec, container, 'tmux', 'attach-session', '-t', 'dev')
    else
      exec(*dexec, container, 'tmux', 'new-session', '-s', 'dev', ';', 'send-keys', cmd, 'Enter')
    end
  end

  def exec_cmd(name, args)
    port = nil
    # Parse optional port
    if args.first =~ /^\d+$/
      port = args.shift
    end
    # Consume optional --
    args.shift if args.first == '--'
    Ky.die('exec requires a command') if args.empty?

    container = Ky::Docker.container_name(name, port)
    Ky.die("container '#{container}' is not running") unless Ky::Docker.running?(container)

    exec('docker', 'exec', '-it', '-u', 'dev', '-w', "/home/dev/projects/#{name}", container, *args)
  end

  def stop(name, port = nil)
    Ky.die('stop requires a project name') unless name
    container = Ky::Docker.container_name(name, port)
    Ky.die("container '#{container}' is not running") unless Ky::Docker.running?(container)
    Ky::Docker.stop(container)
  end

  def start(name, port = nil)
    Ky.die('start requires a project name') unless name
    container = Ky::Docker.container_name(name, port)
    Ky.die("container '#{container}' does not exist\n  Run: kyb create #{name}#{" #{port}" if port}") unless Ky::Docker.exists?(container)
    Ky::Docker.start_existing(container)
  end

  def rm(name, port = nil)
    Ky.die("rm requires a project name\n  Usage: kyb rm NAME [PORT]") unless name
    Ky::Config.load
    proj = Ky::Config.project(name)
    path = proj[:path]
    Ky.die("#{path} not found") unless File.directory?(path)

    container = Ky::Docker.container_name(name, port)
    Ky::Docker.remove_container(container)

    wt_path = Ky::Git.worktree_path(name, container)
    Ky::Git.remove_worktree(path, wt_path)
    Ky::Git.delete_local_branch(path, container)
    Ky::Git.delete_remote_branch(path, container)

    Ky::Docker.volume_rm("#{container}-claude")

    puts "==> Done: #{container} removed  (◕‿‿◕)"
  end

  def prune
    Ky::Config.load
    Ky::Config.project_names.each do |proj_name|
      proj = Ky::Config.project(proj_name)
      path = proj[:path]
      unless File.directory?(path)
        warn "WARNING: #{path} not found, skip #{proj_name}"
        next
      end

      Ky::Docker.containers_for_project(proj_name).each do |c|
        puts "==> #{c}: removing container"
        system('docker', 'rm', '-f', c)

        wt_path = Ky::Git.worktree_path(proj_name, c)
        Ky::Git.remove_worktree(path, wt_path)
        Ky::Git.delete_local_branch(path, c)
        Ky::Git.delete_remote_branch(path, c)

        Ky::Docker.volume_rm("#{c}-claude")
        puts
      end
    end

    puts "==> All sandboxes cleaned  (◕‿‿◕)"
  end

  def help
    puts <<~EOF
      (◕‿‿◕)  kyb

      Usage:  kyb COMMAND

      Commands:
        build                     Build base image
        create NAME [PORT]        Create and start a sandbox
        ps, ls                    List sandbox containers
        enter NAME [PORT]         Enter sandbox via interactive shell
        exec  NAME [PORT] -- CMD  Run command in sandbox
        stop  NAME [PORT]         Stop sandbox container
        start NAME [PORT]         Start stopped sandbox container
        rm    NAME [PORT]         Remove sandbox completely
        prune                     Remove all sandboxes
    EOF
  end

  def dispatch(argv)
    # Pre-flight
    gitconfig = File.expand_path('~/.gitconfig')
    FileUtils.touch(gitconfig) unless File.exist?(gitconfig)

    # GitLab token from glab config
    glab_config = File.expand_path('~/Library/Application Support/glab-cli/config.yml')
    if File.exist?(glab_config)
      token = YAML.safe_load_file(glab_config, permitted_classes: [Symbol, Time]) rescue nil
      ENV['GITLAB_TOKEN'] ||= token&.dig('hosts', 'git.leyantech.com', 'token').to_s
    end

    cmd = argv.first || 'help'
    args = argv[1..] || []

    case cmd
    when 'build'
      build
    when 'create'
      Ky.die("create requires a project name\n  Usage: kyb create NAME [PORT]") unless args.first
      create(args[0], args[1])
    when 'ps', 'ls'
      ps
    when 'enter'
      Ky.die("enter requires a project name\n  Usage: kyb enter NAME [PORT]") unless args.first
      enter(args[0], args[1])
    when 'exec'
      Ky.die("exec requires a project name\n  Usage: kyb exec NAME [PORT] [--] CMD...") unless args.first
      exec_cmd(args[0], args[1..] || [])
    when 'stop'
      stop(args[0], args[1])
    when 'start'
      start(args[0], args[1])
    when 'rm'
      rm(args[0], args[1])
    when 'prune'
      prune
    when 'help', '--help', '-h'
      help
    else
      help
    end
  end
end

Ky::CLI.dispatch(ARGV) if __FILE__ == $PROGRAM_NAME
