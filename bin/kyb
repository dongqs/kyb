#!/usr/bin/env bash
# kyb CLI — shell wrapper that checks Ruby before delegating to the Ruby CLI
set -euo pipefail

KYB_DIR="$(cd "$(dirname "$0")" && pwd)"

# Check Ruby is installed
RUBY=$(command -v ruby 2>/dev/null || true)
if [ -z "$RUBY" ]; then
  cat >&2 <<'EOF'
ERROR: kyb requires Ruby >= 3.0, but ruby is not found.

  Install Ruby via Homebrew:
    brew install ruby

  After install, restart your terminal or run:
    export PATH="/opt/homebrew/opt/ruby/bin:$PATH"

  Then re-run: kyb build
EOF
  exit 1
fi

# Check Ruby version >= 3.0
RUBY_VER=$("$RUBY" -e 'puts RUBY_VERSION' 2>/dev/null || echo "0")
MAJOR="${RUBY_VER%%.*}"
if [ "$MAJOR" -lt 3 ]; then
  cat >&2 <<EOF
ERROR: kyb requires Ruby >= 3.0, found $RUBY_VER.

  Upgrade Ruby via Homebrew:
    brew install ruby

  Then ensure the new ruby is first in PATH:
    export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
EOF
  exit 1
fi

exec "$RUBY" "$KYB_DIR/kyb.rb" "$@"
