#!/usr/bin/env bash
# Tear down a sandbox: container, worktree, branch, volumes
#
#   clean-sandbox niao 3333     clean dev-niao-3333
#   clean-sandbox niao          clean dev-niao
#   clean-sandbox --all         clean ALL sandbox containers
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
CONFIG="$REPO_DIR/projects.toml"
WORKTREE_BASE="$HOME/.orb/worktrees"

# ---------- teardown a single container ----------

teardown() {
    local name="$1" primary="$2" container="$3"

    # 1. 容器
    if docker ps -a --format '{{.Names}}' | grep -qx "$container"; then
        echo "==> $container: removing container"
        docker rm -f "$container"
    else
        echo "==> $container: container not found, skip"
    fi

    # 2. worktree
    local wt_path="${WORKTREE_BASE}/${name}/${container}"
    local branch="sandbox/${container#dev-}"

    if [ -d "$wt_path" ]; then
        echo "==> $branch: removing worktree $wt_path"
        git -C "$primary" worktree remove "$wt_path" 2>/dev/null || {
            echo "     worktree remove failed, pruning..."
            rm -rf "$wt_path"
            git -C "$primary" worktree prune
        }
    else
        echo "==> $branch: worktree not found, skip"
    fi

    # 3. 本地分支（worktree remove 应该已删，这里补刀）
    if git -C "$primary" branch --list "$branch" | grep -q .; then
        echo "==> $branch: deleting local branch"
        git -C "$primary" branch -D "$branch"
    fi

    # 4. 远程分支
    if git -C "$primary" ls-remote --heads origin "$branch" | grep -q .; then
        echo "==> $branch: deleting remote branch"
        git -C "$primary" push origin --delete "$branch"
    fi

    # 5. volumes（可选，默认保留 node_modules 共享 volume）
    local claude_vol="${container}-claude"
    if docker volume ls -q | grep -qx "$claude_vol"; then
        echo "==> $claude_vol: removing volume"
        docker volume rm "$claude_vol"
    fi

    echo "==> Done: $name ${container#dev-}"
}

# ---------- parse project config ----------

get_project_path() {
    local name="$1"
    python3 -c "
import toml, json, sys, os
cfg = toml.load(sys.argv[1])
p = cfg['projects'][sys.argv[2]]
print(os.path.expanduser(p['path']))
" "$CONFIG" "$name"
}

# ---------- main ----------

if [ "${1:-}" = "--all" ]; then
    if [ ! -f "$CONFIG" ]; then
        echo "ERROR: $CONFIG not found"
        exit 1
    fi

    PROJECT_NAMES=$(python3 -c "
import toml, sys
cfg = toml.load(sys.argv[1])
for name in sorted(cfg.get('projects', {}).keys()):
    print(name)
" "$CONFIG")

    for proj in $PROJECT_NAMES; do
        primary=$(get_project_path "$proj")
        if [ ! -d "$primary" ]; then
            echo "WARNING: $primary not found, skip $proj"
            continue
        fi

        containers=$(docker ps -a --format '{{.Names}}' --filter "name=dev-${proj}" 2>/dev/null || true)
        for c in $containers; do
            teardown "$proj" "$primary" "$c"
            echo ""
        done
    done

    echo "==> All sandboxes cleaned"
    exit 0
fi

NAME="${1:-}"
PORT="${2:-}"

if [ -z "$NAME" ]; then
    echo "Usage: clean-sandbox <project> [port]"
    echo "       clean-sandbox --all"
    exit 1
fi

if [ ! -f "$CONFIG" ]; then
    echo "ERROR: $CONFIG not found"
    exit 1
fi

PRIMARY=$(get_project_path "$NAME")
[ -d "$PRIMARY" ] || { echo "ERROR: $PRIMARY not found"; exit 1; }

if [ -n "$PORT" ]; then
    teardown "$NAME" "$PRIMARY" "dev-${NAME}-${PORT}"
else
    teardown "$NAME" "$PRIMARY" "dev-${NAME}"
fi
