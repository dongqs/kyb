#!/bin/bash
# Check for new Feishu events and notify
EVENTS_DIR=/tmp/feishu-events
SEEN_FILE=/tmp/feishu-seen
LOG_FILE=/tmp/feishu-check.log

NOW=$(date '+%H:%M:%S')

# Get list of event files
CURRENT=$(ls "$EVENTS_DIR" 2>/dev/null | wc -l)
if [ -f "$SEEN_FILE" ]; then
  SEEN=$(cat "$SEEN_FILE")
else
  SEEN=0
fi

if [ "$CURRENT" -gt "$SEEN" ]; then
  NEW=$((CURRENT - SEEN))
  echo "$CURRENT" > "$SEEN_FILE"
  # Show the latest message
  LATEST=$(ls -t "$EVENTS_DIR"/*.json 2>/dev/null | head -1)
  if [ -n "$LATEST" ]; then
    CONTENT=$(python3 -c "import sys,json; d=json.load(open(sys.argv[1])); print(d.get('content','')[:200])" "$LATEST" 2>/dev/null)
    SENDER=$(python3 -c "import sys,json; d=json.load(open(sys.argv[1])); print(d.get('sender_id','')[:20])" "$LATEST" 2>/dev/null)
    CHAT=$(python3 -c "import sys,json; d=json.load(open(sys.argv[1])); print(d.get('chat_id','')[:30])" "$LATEST" 2>/dev/null)
    MSG="[Feishu ${NOW}] ${SENDER}: ${CONTENT}"
    echo "$MSG" | tee -a "$LOG_FILE"
    # Also append to tmux buffer for the dev session (if accessible)
    echo "$MSG"
  fi
else
  # No new events, just log heartbeats silently
  :
fi
