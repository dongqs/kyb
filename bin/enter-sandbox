#!/usr/bin/env bash
# Enter dev sandbox. Optionally sync & clone projects.
#
#   enter-sandbox              just enter
#   enter-sandbox all          sync & clone all projects, then enter
#   enter-sandbox click        sync & clone click, then enter
#   enter-sandbox a b c        sync & clone a, b, c, then enter
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
CONTAINER_NAME="dev-sandbox"
BARE_DIR="$HOME/projects/.bare"
PROJECTS_TXT="$REPO_DIR/projects.txt"

# Resolve URL from projects.txt by project name
url_of() {
    local name="$1"
    while IFS= read -r line; do
        [[ -z "$line" || "$line" =~ ^# ]] && continue
        [[ "$(basename "$line" .git)" = "$name" ]] && echo "$line" && return 0
    done < "$PROJECTS_TXT"
    return 1
}

# Post-clone setup: install deps, trust mise config
_post_clone_setup() {
    local name="$1"
    local proj="/home/dev/projects/$name"

    # Trust mise config if present
    if docker exec -u dev "$CONTAINER_NAME" test -f "$proj/mise.toml" 2>/dev/null; then
        echo "  -> $name (mise trust)"
        docker exec -u dev "$CONTAINER_NAME" bash -ic "cd $proj && mise trust" 2>&1 | sed 's/^/     /' || true
    fi

    # npm install if package.json exists and node_modules missing
    if docker exec -u dev "$CONTAINER_NAME" test -f "$proj/package.json" 2>/dev/null && \
       ! docker exec -u dev "$CONTAINER_NAME" test -d "$proj/node_modules" 2>/dev/null; then
        echo "  -> $name (npm install)"
        docker exec -u dev "$CONTAINER_NAME" bash -ic "cd $proj && npm install" 2>&1 | sed 's/^/     /' || true
    fi
}

# Sync bare repo on host and clone into container if needed
sync_project() {
    local name="$1"
    local url
    url=$(url_of "$name") || { echo "  [skip] $name: unknown project"; return; }

    local bare_path="$BARE_DIR/${name}.git"
    mkdir -p "$BARE_DIR"

    if [ -d "$bare_path" ]; then
        echo "  -> $name (fetch bare)"
        git -C "$bare_path" fetch --all --prune 2>&1 | sed 's/^/     /' || true
    else
        echo "  -> $name (clone bare)"
        git clone --bare "$url" "$bare_path" 2>&1 | sed 's/^/     /' || true
    fi

    # Clone into container if not already there
    if ! docker exec -u dev "$CONTAINER_NAME" test -d "/home/dev/projects/$name" 2>/dev/null; then
        echo "  -> $name (clone project)"
        docker exec -u dev "$CONTAINER_NAME" \
            git clone "/home/dev/bare-repos/${name}.git" "/home/dev/projects/$name" 2>&1 | sed 's/^/     /' || true
        docker exec -u dev "$CONTAINER_NAME" \
            git -C "/home/dev/projects/$name" remote set-url origin "$url" 2>&1 || true
        _post_clone_setup "$name"
    else
        echo "  -> $name (exists)"
    fi
}

# --- main ---

PROJECTS=()
if [ $# -gt 0 ]; then
    echo "==> Syncing projects..."
    for arg in "$@"; do
        if [ "$arg" = "all" ]; then
            while IFS= read -r line; do
                [[ -z "$line" || "$line" =~ ^# ]] && continue
                name=$(basename "$line" .git)
                sync_project "$name"
                PROJECTS+=("$name")
            done < "$PROJECTS_TXT"
        else
            sync_project "$arg"
            PROJECTS+=("$arg")
        fi
    done
    echo ""
fi

# Build the shell command for first session creation
if [ ${#PROJECTS[@]} -eq 1 ]; then
    PROJ_NAME="${PROJECTS[0]}"
    CMD="cd ~/projects/${PROJ_NAME} && claude --dangerously-skip-permissions; bash"
elif [ ${#PROJECTS[@]} -gt 1 ]; then
    LIST=$(IFS=', '; echo "${PROJECTS[*]}")
    CMD="echo 'Synced: ${LIST}'; claude --dangerously-skip-permissions; bash"
else
    CMD="bash"
fi

# Attach to existing tmux session, or create one
SESSION="dev"
if docker exec -u dev "$CONTAINER_NAME" tmux has-session -t "$SESSION" 2>/dev/null; then
    exec docker exec -it -u dev -w /home/dev "$CONTAINER_NAME" tmux attach-session -t "$SESSION"
else
    exec docker exec -it -u dev -w /home/dev "$CONTAINER_NAME" tmux new-session -s "$SESSION" \; send-keys "$CMD" Enter
fi

