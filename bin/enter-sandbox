#!/usr/bin/env bash
# Enter a project sandbox container via tmux
#
#   enter-sandbox               default container
#   enter-sandbox niao          dev-niao
#   enter-sandbox niao 3000     dev-niao-3000
set -euo pipefail

PROJ="${1:-}"
PORT="${2:-}"
if [ -n "$PROJ" ] && [ -n "$PORT" ]; then
    CONTAINER="dev-${PROJ}-${PORT}"
elif [ -n "$PROJ" ]; then
    CONTAINER="dev-${PROJ}"
else
    CONTAINER="dev-sandbox"
fi
SESSION="dev"

# Check if container is running
if ! docker ps --format '{{.Names}}' | grep -qx "$CONTAINER"; then
    echo "ERROR: container '$CONTAINER' is not running"
    echo "Run: ~/orb/bin/create-sandbox${PROJ:+ $PROJ}${PORT:+ $PORT}"
    exit 1
fi

# Build startup command for new sessions
if [ -n "$PROJ" ]; then
    CMD="cd ~/projects/$PROJ && mise trust && claude"
else
    CMD="claude"
fi

# Attach to existing tmux session, or create one
if docker exec -u dev "$CONTAINER" tmux has-session -t "$SESSION" 2>/dev/null; then
    DOCKER_EXEC=(docker exec -it -u dev -w /home/dev)
    [ -n "${KIMI_API_KEY:-}" ] && DOCKER_EXEC+=(-e "KIMI_API_KEY=$KIMI_API_KEY")
    exec "${DOCKER_EXEC[@]}" "$CONTAINER" tmux attach-session -t "$SESSION"
else
    DOCKER_EXEC=(docker exec -it -u dev -w /home/dev)
    [ -n "${KIMI_API_KEY:-}" ] && DOCKER_EXEC+=(-e "KIMI_API_KEY=$KIMI_API_KEY")
    exec "${DOCKER_EXEC[@]}" "$CONTAINER" tmux new-session -s "$SESSION" \; send-keys "$CMD" Enter
fi