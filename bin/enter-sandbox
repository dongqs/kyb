#!/usr/bin/env bash
# Enter a project sandbox container via tmux
set -euo pipefail

CONTAINER="dev-${1:-sandbox}"
SESSION="dev"

# Check if container is running
if ! docker ps --format '{{.Names}}' | grep -qx "$CONTAINER"; then
    echo "ERROR: container '$CONTAINER' is not running"
    echo "Run: ~/orb/bin/create-sandbox"
    exit 1
fi

# Attach to existing tmux session, or create one
if docker exec -u dev "$CONTAINER" tmux has-session -t "$SESSION" 2>/dev/null; then
    exec docker exec -it -u dev -w /home/dev "$CONTAINER" tmux attach-session -t "$SESSION"
else
    exec docker exec -it -u dev -w /home/dev "$CONTAINER" tmux new-session -s "$SESSION"
fi