#!/bin/bash
# lark-claude-bridge: Bridge Feishu messages to Claude Code via lark-cli event bus
#
# Architecture:
#   tmux session (PTY) → lark-cli event consume (--output-dir .lark-events/)
#   → lark-watcher (background) → claude --print --continue → reply to Feishu
#
# Usage:
#   lark-claude-bridge start   # Start the bridge
#   lark-claude-bridge stop    # Stop everything
#   lark-claude-bridge status  # Check status
#   lark-claude-bridge attach  # Attach to consumer tmux session (debug)

set -euo pipefail

SRC_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BRIDGE_DIR="$SRC_DIR"
EVENT_LOG="/tmp/lark-claude-bridge-events.log"
CLAUDE_LOG="/tmp/lark-claude-bridge-claude.log"
REPLY_LOG="/tmp/lark-claude-bridge-reply.log"
WATCHER_PIDFILE="/tmp/lark-claude-bridge-watcher.pid"
EVENTS_DIR="$BRIDGE_DIR/.lark-events"
PROCESSED_DIR="$EVENTS_DIR/.processed"
TMUX_SESSION="feishu-consumer"
WATCHER_SCRIPT="$SRC_DIR/bin/lark-watcher"

start_bridge() {
  echo "Starting lark-claude-bridge..."
  mkdir -p "$EVENTS_DIR" "$PROCESSED_DIR"

  # Step 1: Start event consumer in a tmux session
  # lark-cli event consume exits when stdin is closed (built-in EOF signal).
  # tmux provides a persistent PTY that never sends EOF.
  echo "  Starting event consumer (tmux: $TMUX_SESSION)..."
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null || true
  cd "$BRIDGE_DIR"
  tmux new-session -d -s "$TMUX_SESSION" \
    "cd '$BRIDGE_DIR' && exec lark-cli event consume im.message.receive_v1 --as bot --output-dir .lark-events 2>&1 | tee /tmp/lark-claude-bridge-consumer.log"
  sleep 3

  # Step 2: Start polling watcher as a detached subprocess
  echo "  Starting event watcher..."
  nohup "$WATCHER_SCRIPT" "$BRIDGE_DIR" "$EVENTS_DIR" "$PROCESSED_DIR" \
    "$EVENT_LOG" "$CLAUDE_LOG" "$REPLY_LOG" >/dev/null 2>&1 &
  WATCHER_PID=$!
  echo "$WATCHER_PID" > "$WATCHER_PIDFILE"
  echo "  Watcher PID: $WATCHER_PID"

  echo ""
  echo "Bridge started."
  echo "  Consumer: tmux session '$TMUX_SESSION' (attach: $0 attach)"
  echo "  Watcher:  PID $WATCHER_PID"
  echo "  Logs:     $EVENT_LOG (events) | $CLAUDE_LOG (claude stderr) | $REPLY_LOG (replies)"
}

stop_bridge() {
  echo "Stopping lark-claude-bridge..."
  [ -f "$WATCHER_PIDFILE" ] && kill "$(cat "$WATCHER_PIDFILE")" 2>/dev/null || true
  rm -f "$WATCHER_PIDFILE"
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null || true
  lark-cli event stop --force 2>/dev/null || true
  echo "Bridge stopped."
}

status_bridge() {
  echo "=== lark-claude-bridge status ==="
  local cons="stopped" watch="stopped"

  tmux has-session -t "$TMUX_SESSION" 2>/dev/null && cons="running"
  [ -f "$WATCHER_PIDFILE" ] && kill -0 "$(cat "$WATCHER_PIDFILE")" 2>/dev/null && watch="running (PID $(cat "$WATCHER_PIDFILE"))"

  echo "  Consumer: $cons"
  echo "  Watcher:  $watch"

  echo ""
  echo "Event bus:"
  lark-cli event status 2>&1 || echo "  (no bus)"
  echo ""
  echo "Events log (last 5):"
  tail -5 "$EVENT_LOG" 2>/dev/null || echo "  (empty)"
  echo ""
  local count=0
  [ -d "$PROCESSED_DIR" ] && count=$(ls -1 "$PROCESSED_DIR" 2>/dev/null | wc -l)
  echo "Processed: $count event(s)"
}

case "${1:-start}" in
  start)    stop_bridge 2>/dev/null || true; start_bridge ;;
  stop)     stop_bridge ;;
  restart)  stop_bridge; sleep 1; start_bridge ;;
  status)   status_bridge ;;
  attach)   tmux attach-session -t "$TMUX_SESSION" 2>/dev/null || echo "Session '$TMUX_SESSION' not found" ;;
  *)        echo "Usage: $0 {start|stop|restart|status|attach}"; exit 1 ;;
esac
