#!/bin/bash
# Continuous polling loop for Feishu events
# Runs the check script every 5 seconds
# Sends notifications to target tmux sessions

EVENTS_DIR=/tmp/feishu-events
SEEN_FILE=/tmp/feishu-seen
TARGET_SESSION="${TMUX_TARGET_SESSION:-dev}"

# Source user ID to display name mappings
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/../conf/feishu-users.sh"

# Initialize seen count
ls "$EVENTS_DIR" 2>/dev/null | wc -l > "$SEEN_FILE" 2>/dev/null || echo 0 > "$SEEN_FILE"

echo "[feishu-poll] started at $(date '+%H:%M:%S'), watching $EVENTS_DIR"

while true; do
  CURRENT=$(ls "$EVENTS_DIR" 2>/dev/null | wc -l)
  SEEN=$(cat "$SEEN_FILE" 2>/dev/null || echo 0)

  if [ "$CURRENT" -gt "$SEEN" ]; then
    NEW=$((CURRENT - SEEN))
    echo "$CURRENT" > "$SEEN_FILE"

    LATEST=$(ls -t "$EVENTS_DIR"/*.json 2>/dev/null | head -1)
    if [ -n "$LATEST" ]; then
      CONTENT=$(python3 -c "
import sys,json
d=json.load(open(sys.argv[1]))
print(d.get('content','?')[:200])
" "$LATEST" 2>/dev/null)

      SENDER_ID=$(python3 -c "
import sys,json
d=json.load(open(sys.argv[1]))
print(d.get('sender_id','?'))
" "$LATEST" 2>/dev/null)
      SENDER="${FEISHU_USERS[$SENDER_ID]:-$SENDER_ID}"
      SENDER="${SENDER:0:16}"

      MSG="[Feishu ${NEW}条新消息] ${SENDER}: ${CONTENT}"
      echo "$MSG" > /tmp/feishu-last-msg
      echo "$MSG"

      # Try to notify the target tmux session
      if tmux has-session -t "$TARGET_SESSION" 2>/dev/null; then
        tmux display-message -t "$TARGET_SESSION" "$MSG" 2>/dev/null || true
        # Also send a bell to get attention
        tmux send-keys -t "$TARGET_SESSION" "" 2>/dev/null || true
      fi
    fi
  fi

  sleep 3
done
