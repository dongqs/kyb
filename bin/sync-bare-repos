#!/usr/bin/env bash
# Sync bare repos for local cloning (avoids network in sandbox)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
BARE_DIR="$HOME/projects/.bare"

mkdir -p "$BARE_DIR"

while IFS= read -r url; do
    [[ -z "$url" || "$url" =~ ^# ]] && continue
    repo_name=$(basename "$url" .git)
    bare_path="$BARE_DIR/${repo_name}.git"

    if [ -d "$bare_path" ]; then
        echo "  -> $repo_name (fetch)"
        git -C "$bare_path" fetch --all --prune 2>&1 || true
    else
        echo "  -> $repo_name (clone --bare)"
        git clone --bare "$url" "$bare_path" 2>&1 || true
    fi
done < "$REPO_DIR/projects.txt"
