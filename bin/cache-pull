#!/usr/bin/env bash
# cache-pull: Pull Docker images through the local registry cache
# Usage: cache-pull <image> [<image> ...]
#   Automatically pulls through kyb-registry-cache at localhost:5002
#   and tags the image with its original name
#
# Examples:
#   cache-pull postgres:17-alpine
#   cache-pull nginx:alpine python:3.12-alpine

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# Config
CACHE_NAME="kyb-registry-cache"
CACHE_PORT="${CACHE_PORT:-5002}"
CACHE_HOST="${CACHE_HOST:-localhost}"

# Check if cache is running
cache_running() {
    docker inspect "$CACHE_NAME" >/dev/null 2>&1 || return 1
    local status
    status=$(docker inspect "$CACHE_NAME" --format '{{.State.Status}}' 2>/dev/null)
    [ "$status" = "running" ]
}

if ! cache_running; then
    echo -e "${YELLOW}Registry cache not running, falling back to direct pull${NC}" >&2
    docker pull "$@"
    exit $?
fi

pull_with_cache() {
    local image="$1"
    local cache_ref=""

    # Parse image reference
    if [[ "$image" == */* ]]; then
        # Has repository prefix (e.g., library/nginx, username/image)
        cache_ref="${CACHE_HOST}:${CACHE_PORT}/${image}"
    else
        # Single name (e.g., alpine) -> library/alpine
        cache_ref="${CACHE_HOST}:${CACHE_PORT}/library/${image}"
    fi

    echo -e "${GREEN}Pulling ${image} through cache (${cache_ref})...${NC}" >&2

    # Pull through cache
    if docker pull "$cache_ref" >&2; then
        # Tag with original name
        docker tag "$cache_ref" "$image" >/dev/null 2>&1 || true
        echo -e "${GREEN}Success: ${image}${NC}" >&2

        # Remove cache-prefixed tag (optional, keep it around for speed next time)
        # docker rmi "$cache_ref" >/dev/null 2>&1 || true
    else
        echo -e "${RED}Cache pull failed for ${image}, falling back to direct pull${NC}" >&2
        docker pull "$image"
    fi
}

if [ $# -eq 0 ]; then
    echo "Usage: $0 <image> [<image> ...]" >&2
    exit 1
fi

for img in "$@"; do
    pull_with_cache "$img"
done
