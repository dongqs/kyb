#!/usr/bin/env ruby
# frozen_string_literal: true
$stdout.sync = true
# kyb-feishu-bot — 飞书 bot 主入口
# 绕过 lark-cli，直接调飞书 API 收发消息
#
# 控制闭环:
#   Poll Feishu → 检查新消息 → 检测 @提及 → 处理 → 回复 → [LOOP]
#   每步: 超时10s · 失败重试(退避) · CK 日志 · 健康心跳
#
# 用法:
#   feishu-bot                    # 启动(需设置 FEISHU_APP_ID/APP_SECRET)
#   feishu-bot --help             # 帮助

FEISHU_BOT_HEADER = <<~HEADER
  ╔══════════════════════════════════════╗
  ║    kyb-feishu-bot — ／人◕ ‿‿ ◕人＼   ║
  ║        飞书消息收发 · 去 lark-cli     ║
  ╚══════════════════════════════════════╝
HEADER

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'kyb'

begin
  config = Kyb::FeishuBot.load_config
rescue Kyb::FeishuBot::ConfigError => e
  warn "ERROR: #{e.message}"
  warn ''
  warn "请设置环境变量:"
  warn "  export FEISHU_APP_ID=xxx"
  warn "  export FEISHU_APP_SECRET=xxx"
  warn "  export FEISHU_CHAT_ID=xxx        (可选，默认 kyb-kindergarden)"
  warn "  export FEISHU_POLL_INTERVAL=5  (可选，轮询间隔秒数)"
  exit 1
end

puts FEISHU_BOT_HEADER
Kyb::FeishuBot::Runner.new(config).run
