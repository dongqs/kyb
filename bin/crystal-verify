#!/usr/bin/env bash
set -e

# ─── 负熵晶体 · 验真脚本（胖胖/任何人用） ───
# 用法:
#   1. 把对方发来的证明文本保存到文件 proof.txt
#   2. bash crystal-verify < proof.txt
#
# 或一行搞定:
#   curl -sL GIT_URL/raw/master/bin/crystal-verify | bash -s < proof.txt
#
# 不需要 kyb，只需要 bash + ssh-keygen

# ─── 公钥（嵌入脚本，不需要联网） ───
PUBKEY='* ssh-rsa '

TMP=$(mktemp -d /tmp/crystal-verify-XXXXXX)
trap 'rm -rf "$TMP"' EXIT

# 读入证明
cat > "$TMP/proof"

# 解析
MSG=$(sed -n '/^-----BEGIN CRYSTAL PROOF-----$/,/^-----END CRYSTAL PROOF-----$/p' "$TMP/proof" \
  | sed '1d;$d' | grep -v '^ts=' | grep -v '^sig=')
TS=$(grep '^ts=' "$TMP/proof" | sed 's/^ts=//')
SIG_B64=$(grep '^sig=' "$TMP/proof" | sed 's/^sig=//')

if [ -z "$TS" ] || [ -z "$SIG_B64" ]; then
  echo "❌ 无法解析证明文本"
  echo "   内容格式:"
  echo "   -----BEGIN CRYSTAL PROOF-----"
  echo "   消息内容"
  echo "   ts=时间戳"
  echo "   sig=base64签名"
  echo "   -----END CRYSTAL PROOF-----"
  exit 1
fi

# 写入公钥、消息、签名
echo "$PUBKEY" > "$TMP/allowed"
printf '%s\n时间: %s' "$MSG" "$TS" > "$TMP/msg"
echo "$SIG_B64" | base64 -d > "$TMP/sig" 2>/dev/null

if [ $? -ne 0 ] || [ ! -s "$TMP/sig" ]; then
  echo "❌ 签名数据损坏（base64 解码失败）"
  exit 1
fi

# 验真（校验退出码，不依赖输出文本）
if ssh-keygen -Y verify -f "$TMP/allowed" -I "*" -n crystal -s "$TMP/sig" < "$TMP/msg" >/dev/null 2>&1; then
  echo ""
  echo "✅ 签名有效 —— 由负熵晶体（青山）签发"
  echo "   消息: $MSG"
  echo "   时间: $TS"
else
  echo "❌ 签名无效"
  exit 1
fi
