#!/usr/bin/env bash
# Create/rebuild the OrbStack dev sandbox Machine
set -euo pipefail

MACHINE_NAME="${1:-dev-sandbox}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

# --- Read secrets from host ---
SSH_PRIVATE_KEY_B64=$(base64 < "$HOME/.ssh/id_rsa" | tr -d '\n')
SSH_PUBLIC_KEY=$(cat "$HOME/.ssh/id_rsa.pub")
ANTHROPIC_AUTH_TOKEN=$(jq -r '.env.ANTHROPIC_AUTH_TOKEN' "$HOME/.claude/settings.json")
GIT_NAME=$(git config --global user.name)
GIT_EMAIL=$(git config --global user.email)
USER_NAME=$(whoami)

# --- Generate cloud-init with secrets ---
CLOUD_INIT="$REPO_DIR/cloud-init.generated.yaml"

echo "==> Generating cloud-init for user: $USER_NAME"

sed \
  -e "s|__USER__|${USER_NAME}|g" \
  -e "s|__SSH_PRIVATE_KEY_B64__|${SSH_PRIVATE_KEY_B64}|g" \
  -e "s|__SSH_PUBLIC_KEY__|${SSH_PUBLIC_KEY}|g" \
  -e "s|__ANTHROPIC_AUTH_TOKEN__|${ANTHROPIC_AUTH_TOKEN}|g" \
  -e "s|__GIT_NAME__|${GIT_NAME}|g" \
  -e "s|__GIT_EMAIL__|${GIT_EMAIL}|g" \
  "$REPO_DIR/cloud-init.yaml" > "$CLOUD_INIT"

echo "==> Generated: $CLOUD_INIT"

# --- Delete existing Machine if present ---
if orb list 2>/dev/null | grep -q "$MACHINE_NAME"; then
  echo "==> Removing existing Machine: $MACHINE_NAME"
  orb delete "$MACHINE_NAME" --force 2>/dev/null || true
fi

# --- Create Machine ---
echo "==> Creating Machine: $MACHINE_NAME"
orb create ubuntu "$MACHINE_NAME" -c "$CLOUD_INIT"

# --- Wait for Machine SSH ready (handles cloud-init reboot) ---
echo "==> Waiting for Machine to be ready..."
for i in $(seq 1 30); do
  if orb -m "$MACHINE_NAME" true 2>/dev/null; then
    echo "==> Machine is ready"
    break
  fi
  sleep 2
done

# --- Clone projects ---
echo "==> Cloning projects..."
while IFS= read -r url; do
  [[ -z "$url" || "$url" =~ ^# ]] && continue
  repo_name=$(basename "$url" .git)
  echo "  -> $repo_name"
  orb -m "$MACHINE_NAME" su - "$USER_NAME" -c "cd ~/projects && git clone $url" 2>&1 || echo "  [skip] clone failed, may already exist"
done < "$REPO_DIR/projects.txt"

echo ""
echo "==> Done! Enter the sandbox:"
echo "    orb ssh $MACHINE_NAME"
echo ""
echo "    Inside: cd ~/projects/<project> && claude"
