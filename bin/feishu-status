#!/bin/bash
# Feishu event notification system status
echo "=== Tmux Sessions ==="
tmux list-sessions 2>&1
echo ""

echo "=== Consumer Status ==="
if tmux has-session -t feishu-listener 2>/dev/null; then
  PID=$(pgrep -f "lark-cli event consume.*feishu-events" | grep -v defunct | grep -v bash | head -1)
  if [ -n "$PID" ]; then
    echo "feishu-listener: RUNNING (PID $PID)"
    UPTIME=$(ps -o etime= -p $PID 2>/dev/null)
    echo "  uptime: $UPTIME"
  else
    echo "feishu-listener: SESSION UP but NO consumer process"
  fi
  echo "  output: /tmp/feishu-events/"
else
  echo "feishu-listener: NOT RUNNING"
fi
echo ""

echo "=== Monitor Status ==="
if tmux has-session -t feishu-monitor 2>/dev/null; then
  echo "feishu-monitor: RUNNING"
else
  echo "feishu-monitor: NOT RUNNING"
fi
echo ""

echo "=== Events ==="
COUNT=$(ls /tmp/feishu-events/*.json 2>/dev/null | wc -l)
echo "total: $COUNT"
echo ""
echo "Latest messages:"
# Source user ID to display name mappings
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/../conf/feishu-users.sh" 2>/dev/null || true
ls -t /tmp/feishu-events/*.json 2>/dev/null | head -3 | while read f; do
  SENDER_ID=$(python3 -c "import sys,json; d=json.load(open('$f')); print(d.get('sender_id','?'))" 2>/dev/null)
  NAME="${FEISHU_USERS[$SENDER_ID]:-$SENDER_ID}"
  NAME="${NAME:0:16}"
  CONTENT=$(python3 -c "import sys,json; d=json.load(open('$f')); print(d.get('content','')[:80])" 2>/dev/null)
  echo "  [${NAME}] ${CONTENT}"
done

echo ""
echo "=== Commands ==="
echo "  tmux attach -t feishu-listener  # view consumer log"
echo "  tmux attach -t feishu-monitor   # view monitor log"
echo "  cat /tmp/feishu-notifications.log  # notification history"
