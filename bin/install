#!/bin/bash
set -e

BIN_DIR="${HOME}/.local/bin"
LIB_DIR="${HOME}/.local/lib/kyb"

script_dir="$(cd "$(dirname "$0")" && pwd)"
project_dir="$(cd "$script_dir/.." && pwd)"

version=$(sed -n "s/.*VERSION = '\\([^']*\\)'.*/\\1/p" "$project_dir/lib/kyb.rb")
echo "==> Installing kyb $version"

mkdir -p "$BIN_DIR" "$LIB_DIR"

rm -f "$BIN_DIR/kyb"
ln -sf "$project_dir/bin/kyb" "$BIN_DIR/kyb"
rm -rf "$LIB_DIR"
mkdir -p "$LIB_DIR"
cp "$project_dir/lib/kyb.rb" "$LIB_DIR/../kyb.rb"
cp -r "$project_dir/lib/kyb/"* "$LIB_DIR/"

echo "==> Done: $BIN_DIR/kyb"
echo "    Ensure ~/.local/bin is in your PATH"
