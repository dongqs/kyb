#!/usr/bin/env bash
# Build base image, create per-project containers from projects.toml
#
#   create-sandbox              build base image only
#   create-sandbox niao         create dev-niao (TOML ports)
#   create-sandbox niao 3000    create dev-niao-3000 (-p 3000:3000)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
BASE_IMAGE="dev-sandbox-base"
CONFIG="$REPO_DIR/projects.toml"

# ---------- helpers ----------

build_base() {
    echo "==> Building base image: $BASE_IMAGE"
    docker build -t "$BASE_IMAGE" "$REPO_DIR"
}

create_container() {
    local name="$1" path="$2" df="$3" ports="$4" container="$5"

    # Build project-specific image if Dockerfile specified
    if [ -n "$df" ]; then
        local IMAGE="dev-${name}"
        echo "==> $name: building project image (${df})"
        docker build -t "$IMAGE" -f "${path}/${df}" "$path"
    else
        local IMAGE="$BASE_IMAGE"
    fi

    # Remove existing container
    docker rm -f "$container" 2>/dev/null || true

    # Build port mapping args
    local PORT_ARGS=()
    if [ -n "${ports:-}" ]; then
        IFS=',' read -ra PORT_LIST <<< "$ports"
        for p in "${PORT_LIST[@]}"; do
            [ -n "$p" ] && PORT_ARGS+=(-p "$p")
        done
    fi

    echo "==> $container: starting ($path -> /home/dev/projects/$name)"
    docker run -d \
        --name "$container" \
        --hostname "$container" \
        -e "HOST_UID=$(id -u)" \
        -e "HOST_GID=$(id -g)" \
        -e "GITLAB_TOKEN=${GITLAB_TOKEN:-}" \
        -e "CLAUDE_CODE_ATTRIBUTION_HEADER=${CLAUDE_CODE_ATTRIBUTION_HEADER:-}" \
        -e "CLAUDE_CODE_EFFORT_LEVEL=${CLAUDE_CODE_EFFORT_LEVEL:-}" \
        -v "$HOME/.ssh:/home/dev/.ssh:ro" \
        -v "$HOME/.gitconfig:/home/dev/.gitconfig:ro" \
        -v "$HOME/.claude/settings.json:/home/dev/.claude-host-settings.json:ro" \
        -v "$HOME/.claude/skills:/home/dev/.claude-skills-host:ro" \
        -v "$HOME/.agents:/home/.agents:ro" \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "${container}-claude:/home/dev/.claude" \
        -v "${path}:/home/dev/projects/${name}" \
        -v "${container}-node_modules:/home/dev/projects/${name}/node_modules" \
        ${PORT_ARGS:+"${PORT_ARGS[@]}"} \
        "$IMAGE"

    echo "     container=$container  image=$IMAGE  ports=${ports:-none}"
}

# ---------- main ----------

if [ ! -f "$CONFIG" ]; then
    echo "ERROR: $CONFIG not found"
    exit 1
fi

touch "$HOME/.gitconfig"
GITLAB_TOKEN="$(awk '/^[[:space:]]*token:/{print $2; exit}' "$HOME/Library/Application Support/glab-cli/config.yml" 2>/dev/null || true)"

PROJ_NAME="${1:-}"
HOST_PORT="${2:-}"

if [ -z "$PROJ_NAME" ]; then
    build_base
    echo ""
    echo "==> Done! Base image ready. Create containers with:"
    echo "    ~/orb/bin/create-sandbox niao"
    echo "    ~/orb/bin/create-sandbox niao 3000"
    exit 0
fi

# Parse project from TOML
PROJECTS_JSON=$(
    python3 -c '
import toml, json, sys, os

cfg = toml.load(sys.argv[1])
target = sys.argv[2] if len(sys.argv) > 2 else ""
projects = cfg.get("projects", {})
for name, p in projects.items():
    if target and name != target:
        continue
    item = {"name": name, "path": os.path.expanduser(p["path"])}
    if "dockerfile" in p:
        item["dockerfile"] = p["dockerfile"]
    ports = p.get("ports", [])
    item["ports"] = ",".join(ports) if ports else ""
    print(json.dumps(item))
' "$CONFIG" "$PROJ_NAME"
)

if [ -z "$PROJECTS_JSON" ]; then
    echo "ERROR: '$PROJ_NAME' not found in $CONFIG"
    exit 1
fi

build_base
echo ""

name=$(echo "$PROJECTS_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["name"])')
path=$(echo "$PROJECTS_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])')
df=$(echo "$PROJECTS_JSON" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("dockerfile",""))')

if [ -n "$HOST_PORT" ]; then
    CONTAINER="dev-${name}-${HOST_PORT}"
    PORTS="${HOST_PORT}:3000"
else
    CONTAINER="dev-${name}"
    PORTS=$(echo "$PROJECTS_JSON" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("ports",""))')
fi

create_container "$name" "$path" "$df" "$PORTS" "$CONTAINER"

echo ""
echo "==> Done! Enter:"
echo "    ~/orb/bin/enter-sandbox $PROJ_NAME${HOST_PORT:+ $HOST_PORT}"