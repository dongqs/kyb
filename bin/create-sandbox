#!/usr/bin/env bash
# Build base image, create per-project containers from projects.toml
#
#   create-sandbox              build base image only
#   create-sandbox niao         create dev-niao (TOML ports)
#   create-sandbox niao 3000    create dev-niao-3000 (-p 3000:3000)
#
# Each container gets an isolated git worktree to avoid conflicts when
# multiple instances share the same project.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
BASE_IMAGE="dev-sandbox-base"
CONFIG="$REPO_DIR/projects.toml"
WORKTREE_BASE="$HOME/.orb/worktrees"

# ---------- helpers ----------

build_base() {
    echo "==> Building base image: $BASE_IMAGE"
    docker build -t "$BASE_IMAGE" "$REPO_DIR"
}

setup_worktree() {
    local name="$1" primary="$2" base_branch="$3" container="$4"
    local wt_path="${WORKTREE_BASE}/${name}/${container}"

    if [ -d "$wt_path" ]; then
        echo "==> $name: worktree exists, reusing ($wt_path)"
        echo "$wt_path"
        return
    fi

    local branch="sandbox/${container#dev-}"
    echo "==> $name: creating worktree from origin/$base_branch ($branch)"
    mkdir -p "$(dirname "$wt_path")"

    cd "$primary"
    git fetch origin "$base_branch"
    git worktree add "$wt_path" "origin/${base_branch}" -b "$branch"

    echo "$wt_path"
}

setup_symlinks() {
    local primary="$1" wt_path="$2" symlinks="$3"

    if [ -n "${symlinks:-}" ]; then
        IFS=',' read -ra LINKS <<< "$symlinks"
        for link in "${LINKS[@]}"; do
            [ -z "$link" ] && continue
            echo "     ln -sf $primary/$link -> worktree/$link"
            ln -sf "${primary}/${link}" "${wt_path}/${link}"
        done
    fi
}

setup_env() {
    local primary="$1" wt_path="$2" env_template="$3"

    if [ -n "${env_template:-}" ]; then
        echo "     cp $primary/$env_template -> .env"
        cp "${primary}/${env_template}" "${wt_path}/.env"
    fi
}

create_container() {
    local name="$1" primary="$2" worktree="$3" df="$4" ports="$5" container="$6"

    # Build project-specific image if Dockerfile specified
    if [ -n "$df" ]; then
        local IMAGE="dev-${name}"
        echo "==> $name: building project image (${df})"
        docker build -t "$IMAGE" -f "${primary}/${df}" "$primary"
    else
        local IMAGE="$BASE_IMAGE"
    fi

    # Remove existing container
    docker rm -f "$container" 2>/dev/null || true

    # Ensure host .kimi dir exists (otherwise Docker creates as root)
    mkdir -p "$HOME/.kimi"

    # Build port mapping args
    local PORT_ARGS=()
    if [ -n "${ports:-}" ]; then
        IFS=',' read -ra PORT_LIST <<< "$ports"
        for p in "${PORT_LIST[@]}"; do
            [ -n "$p" ] && PORT_ARGS+=(-p "$p")
        done
    fi

    echo "==> $container: starting ($worktree -> /home/dev/projects/$name)"
    docker run -d \
        --name "$container" \
        --hostname "$container" \
        -e "HOST_UID=$(id -u)" \
        -e "HOST_GID=$(id -g)" \
        -e "GITLAB_TOKEN=${GITLAB_TOKEN:-}" \
        -e "CLAUDE_CODE_ATTRIBUTION_HEADER=${CLAUDE_CODE_ATTRIBUTION_HEADER:-}" \
        -e "CLAUDE_CODE_EFFORT_LEVEL=${CLAUDE_CODE_EFFORT_LEVEL:-}" \
        -e "KIMI_API_KEY=${KIMI_API_KEY:-}" \
        -e "SANDBOX_PROJECT=${name}" \
        -v "$HOME/.ssh:/home/dev/.ssh:ro" \
        -v "$HOME/.kimi:/home/dev/.kimi" \
        -v "$HOME/.gitconfig:/home/dev/.gitconfig:ro" \
        -v "$HOME/.claude/settings.json:/home/dev/.claude-host-settings.json:ro" \
        -v "$HOME/.claude/skills:/home/dev/.claude-skills-host:ro" \
        -v "$HOME/.agents:/home/.agents:ro" \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "${container}-claude:/home/dev/.claude" \
        -v "${worktree}:/home/dev/projects/${name}" \
        -v "${name}-node_modules:/home/dev/projects/${name}/node_modules" \
        ${PORT_ARGS:+"${PORT_ARGS[@]}"} \
        "$IMAGE"

    echo "     container=$container  image=$IMAGE  ports=${ports:-none}"
}

# ---------- main ----------

if [ ! -f "$CONFIG" ]; then
    echo "ERROR: $CONFIG not found"
    exit 1
fi

touch "$HOME/.gitconfig"
GITLAB_TOKEN="$(awk '/^[[:space:]]*token:/{print $2; exit}' "$HOME/Library/Application Support/glab-cli/config.yml" 2>/dev/null || true)"

PROJ_NAME="${1:-}"
HOST_PORT="${2:-}"

if [ -z "$PROJ_NAME" ]; then
    build_base
    echo ""
    echo "==> Done! Base image ready. Create containers with:"
    echo "    ~/orb/bin/create-sandbox niao"
    echo "    ~/orb/bin/create-sandbox niao 3000"
    exit 0
fi

# Parse project from TOML
PROJECTS_JSON=$(
    python3 -c '
import toml, json, sys, os

cfg = toml.load(sys.argv[1])
target = sys.argv[2] if len(sys.argv) > 2 else ""
projects = cfg.get("projects", {})
for name, p in projects.items():
    if target and name != target:
        continue
    item = {
        "name": name,
        "path": os.path.expanduser(p["path"]),
        "base_branch": p["base_branch"],
    }
    if "dockerfile" in p:
        item["dockerfile"] = p["dockerfile"]
    ports = p.get("ports", [])
    item["ports"] = ",".join(ports) if ports else ""
    symlinks = p.get("symlinks", [])
    item["symlinks"] = ",".join(symlinks) if symlinks else ""
    item["env_template"] = p.get("env_template", "")
    print(json.dumps(item))
' "$CONFIG" "$PROJ_NAME"
)

if [ -z "$PROJECTS_JSON" ]; then
    echo "ERROR: '$PROJ_NAME' not found in $CONFIG"
    exit 1
fi

extract() {
    echo "$PROJECTS_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin).get('$1',''))"
}

name=$(extract name)
path=$(extract path)
base_branch=$(extract base_branch)
df=$(extract dockerfile)
symlinks=$(extract symlinks)
env_template=$(extract env_template)

build_base
echo ""

if [ -n "$HOST_PORT" ]; then
    CONTAINER="dev-${name}-${HOST_PORT}"
    PORTS="${HOST_PORT}:3000"
else
    CONTAINER="dev-${name}"
    PORTS=$(extract ports)
fi

WORKTREE=$(setup_worktree "$name" "$path" "$base_branch" "$CONTAINER")
setup_symlinks "$path" "$WORKTREE" "$symlinks"
setup_env "$path" "$WORKTREE" "$env_template"
create_container "$name" "$path" "$WORKTREE" "$df" "$PORTS" "$CONTAINER"

echo ""
echo "==> Done! Enter:"
echo "    ~/orb/bin/enter-sandbox $PROJ_NAME${HOST_PORT:+ $HOST_PORT}"